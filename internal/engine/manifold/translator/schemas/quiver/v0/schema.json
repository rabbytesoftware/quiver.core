  "properties": {
    "schema":      { "type": "string" },
    "name":        { "type": "string" },
    "description": { "type": "string" },
    "url":         { "type": "string" },
    "maintainers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon":   { "type": "string" },
        "banner": { "type": "string" }
      }
    },
    "arrows": {
