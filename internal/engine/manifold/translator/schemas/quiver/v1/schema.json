{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Quiver Repository v1",
	"type": "object",
	"required": ["manifest", "metadata"],
	"properties": {
		"manifest": {
			"type": "string",
			"const": "quiver@v1"
		},
		"metadata": {
			"type": "object",
			"required": ["name", "description", "version"],
			"properties": {
				"name": { "type": "string" },
				"description": { "type": "string" },
				"version": { "type": "string" }
			},
			"additionalProperties": false
		}
	},
	"additionalProperties": false
}
