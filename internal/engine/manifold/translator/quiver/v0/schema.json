{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema", "metadata"],
  "properties": {
    "schema": { "type": "string", "pattern": "^quiver@" },
    "metadata": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name":        { "type": "string" },
        "version":     { "type": "string" },
        "description": { "type": "string" },
        "url":         { "type": "string" },
        "maintainers": { "type": "array", "items": { "type": "string" } },
        "tags":        { "type": "array", "items": { "type": "string" } },
        "media": {
          "type": "object",
          "properties": {
            "icon":   { "type": "string" },
            "banner": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "arrows": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "path":      { "type": "string" },
              "namespace": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
