{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArrowV0",
  "type": "object",
  "required": ["schema", "name", "version"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string" },
    "name":        { "type": "string" },
    "description": { "type": "string" },
    "version":     { "type": "string" },
    "license":     { "type": "string" },
    "url":         { "type": "string" },
    "maintainers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name":  { "type": "string" },
          "email": { "type": "string" },
          "url":   { "type": "string" }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_cores": { "type": "integer", "minimum": 1 },
        "ram_gb":    { "type": "integer", "minimum": 1 },
        "disk_gb":   { "type": "integer", "minimum": 1 },
        "os": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name":        { "type": "string" },
          "description": { "type": "string" },
          "default":     { "type": "string" },
          "sensitive":   { "type": "boolean" },
          "values": {
            "type": "array",
            "items": { "type": "string" }
          },
          "min":  { "type": "integer" },
          "max":  { "type": "integer" },
          "type": { "type": "string" }
        }
      }
    },
    "netbridge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "protocol"],
        "additionalProperties": false,
        "properties": {
          "name":     { "type": "string" },
          "protocol": { "type": "string" },
          "default":  { "type": "integer" },
          "required": { "type": "boolean" }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install":   { "$ref": "#/definitions/StepList" },
        "execute":   { "$ref": "#/definitions/StepList" },
        "stop":      { "$ref": "#/definitions/StepList" },
        "uninstall": { "$ref": "#/definitions/StepList" }
      }
    },
    "methods": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "available_in": {
            "type": "array",
            "items": { "type": "string" }
          },
          "steps": { "$ref": "#/definitions/StepList" }
        }
      }
    }
  },
  "definitions": {
    "StepList": {
      "type": "array",
      "items": { "$ref": "#/definitions/Step" }
    },
    "Step": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type":           { "type": "string" },
        "command":        { "type": "string" },
        "url":            { "type": "string" },
        "to":             { "type": "string" },
        "signal":         { "type": "string" },
        "title":          { "type": "string" },
        "timeout":        { "type": "string" },
        "exit_on_failure":{ "type": "boolean" }
      }
    }
  }
}
