{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Quiver's Arrow v1",
	"type": "object",
	"required": [
		"manifest",
		"metadata",
		"requirements",
		"netbridge",
		"variables",
		"methods"
	],
	"properties": {
		"manifest": {
			"type": "string",
			"const": "arrow@v1"
		},
		"metadata": {
			"type": "object",
			"required": [
				"version",
				"license",
				"quiver_url",
				"name",
				"description",
				"media",
				"credits"
			],
			"properties": {
				"version": { "type": "string" },
				"license": { "type": "string" },
				"quiver_url": { "type": "string", "format": "uri" },
				"name": { "type": "string" },
				"description": { "type": "string" },
				"media": {
					"type": "object",
					"required": ["icon", "banner"],
					"properties": {
						"icon": { "type": "string", "format": "uri" },
						"banner": { "type": "string", "format": "uri" }
					},
					"additionalProperties": false
				},
				"credits": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["name", "email", "url"],
						"properties": {
							"name": { "type": "string" },
							"email": { "type": "string", "format": "email" },
							"url": { "type": "string", "format": "uri" }
						},
						"additionalProperties": false
					},
					"minItems": 1
				}
			},
			"additionalProperties": false
		},
		"requirements": {
			"type": "object",
			"required": [
				"cpu_cores",
				"ram_gb",
				"disk_gb",
				"network_mbps",
				"system"
			],
			"properties": {
				"cpu_cores": { "type": "integer", "minimum": 1 },
				"ram_gb": { "type": "integer", "minimum": 1 },
				"disk_gb": { "type": "integer", "minimum": 1 },
				"network_mbps": { "type": "integer", "minimum": 1 },
				"system": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"windows/amd64",
							"windows/arm64",
							"linux/amd64",
							"linux/arm64",
							"darwin/amd64",
							"darwin/arm64"
						]
					},
					"minItems": 1,
					"uniqueItems": true
				}
			},
			"additionalProperties": false
		},
		"netbridge": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["name", "protocol"],
				"properties": {
					"name": { "type": "string" },
					"protocol": {
						"type": "string",
						"enum": ["tcp", "udp", "tcp/udp"]
					}
				},
				"additionalProperties": false
			},
			"minItems": 1
		},
		"variables": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["name", "default", "sensitive"],
				"properties": {
					"name": { "type": "string" },
					"default": { "type": "string" },
					"sensitive": { "type": "boolean" }
				},
				"additionalProperties": false
			}
		},
		"methods": {
			"type": "object",
			"required": ["windows", "linux", "darwin"],
			"properties": {
				"windows": {
					"$ref": "#/$defs/osMethods"
				},
				"linux": {
					"$ref": "#/$defs/osMethods"
				},
				"darwin": {
					"$ref": "#/$defs/osMethods"
				}
			},
			"additionalProperties": false
		}
	},
	"additionalProperties": false,
	"$defs": {
		"archMethods": {
			"type": "object",
			"required": [
				"install",
				"execute",
				"uninstall",
				"update",
				"validate"
			],
			"properties": {
				"install": { "$ref": "#/$defs/commandList" },
				"execute": { "$ref": "#/$defs/commandList" },
				"uninstall": { "$ref": "#/$defs/commandList" },
				"update": { "$ref": "#/$defs/commandList" },
				"validate": { "$ref": "#/$defs/commandList" }
			},
			"additionalProperties": false
		},
		"osMethods": {
			"type": "object",
			"required": ["amd64", "arm64"],
			"properties": {
				"amd64": { "$ref": "#/$defs/archMethods" },
				"arm64": { "$ref": "#/$defs/archMethods" }
			},
			"additionalProperties": false
		},
		"commandList": {
			"type": "array",
			"items": { "type": "string" },
			"minItems": 1
		}
	}
}
