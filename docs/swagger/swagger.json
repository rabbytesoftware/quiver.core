                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/github_com_rabbytesoftware_quiver_internal_api_v0_dto.ValidationResultDTO"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "$ref": "#/definitions/github_com_rabbytesoftware_quiver_internal_api_libs.ErrResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns {\"status\":\"ok\"} when the daemon is running.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Daemon is healthy",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/runtime/{ns}/{method}": {
            "post": {
                "description": "Triggers a lifecycle method on an arrow (install, uninstall, execute, stop, update, or any custom method defined in the manifest). Returns 202 Accepted immediately; progress is streamed via WebSocket.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "runtime"
                ],
                "summary": "Execute method",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Arrow namespace",
                        "name": "ns",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Method name (install | uninstall | execute | stop | update | \u003ccustom\u003e)",
                        "name": "method",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Optional variables",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/github_com_rabbytesoftware_quiver_internal_api_v0_dto.ExecuteMethodRequestDTO"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Method accepted",
                        "schema": {
                            "$ref": "#/definitions/github_com_rabbytesoftware_quiver_internal_api_libs.MutationResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "schema": {
                            "$ref": "#/definitions/github_com_rabbytesoftware_quiver_internal_api_libs.ErrResponse"
                        }
                    },
                    "404": {
                        "description": "Arrow not found",
                        "schema": {
                            "$ref": "#/definitions/github_com_rabbytesoftware_quiver_internal_api_libs.ErrResponse"
                        }
                    },
                    "409": {
                        "description": "Arrow already running",
                        "schema": {
                            "$ref": "#/definitions/github_com_rabbytesoftware_quiver_internal_api_libs.ErrResponse"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "$ref": "#/definitions/github_com_rabbytesoftware_quiver_internal_api_libs.ErrResponse"
                        }
                    }
                }
            }
        }
    },
