                        "name": "ns",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Raw YAML manifest",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Manifest is valid",
